function _df_dir_name($project, $proposar_name) {
	$project_title = ucwords($project);
	$proposar_name = ucwords($proposar_name);
	$dir_name = $project_title . ' By ' . $proposar_name;
	$directory_name = str_replace("__", "_", str_replace(" ", "_", str_replace("/", " ", $dir_name)));
	return $directory_name;
}

function dwsim_flowsheet_document_path() {
	return $_SERVER['DOCUMENT_ROOT'] . base_path() . 'dwsim_uploads/dwsim_flowsheet_uploads/';
}

function DF_RenameDir($proposal_id, $dir_name) {
	$query = \Drupal::database()->query("SELECT directory_name,id FROM dwsim_flowsheet_proposal WHERE id = :proposal_id", [
		':proposal_id' => $proposal_id,
	]);
	$result = $query->fetchObject();
	if ($result != NULL) {
		$files_id_dir = dwsim_flowsheet_path() . $result->id;
		$file_dir = dwsim_flowsheet_path() . $result->directory_name;
		if (is_dir($file_dir)) {
			$new_directory_name = rename(dwsim_flowsheet_path() . $result->directory_name, dwsim_flowsheet_path() . $dir_name);
			return $new_directory_name;
		}
		else if (is_dir($files_id_dir)) {
			$new_directory_name = rename(dwsim_flowsheet_path() . $result->id, dwsim_flowsheet_path() . $dir_name);
			return $new_directory_name;
		}
		else {
			\Drupal::messenger()->addMessage('Directory not available for rename.');
			return;
		}
	}
	else {
		\Drupal::messenger()->addMessage('Project directory name not present in database');
		return;
	}
}

function CreateReadmeFileDWSIMFlowsheetingProject($proposal_id) {
	$result = \Drupal::database()->query("SELECT * from dwsim_flowsheet_proposal WHERE id = :proposal_id", [
		':proposal_id' => $proposal_id,
	]);
	$proposal_data = $result->fetchObject();
	$root_path = dwsim_flowsheet_path();
	$readme_file = fopen($root_path . $proposal_data->directory_name . "/README.txt", "w") or die("Unable to open file!");
	$txt = "";
	$txt .= "About the flowsheet";
	$txt .= "\n" . "\n";
	$txt .= "Title Of The Flowsheet Project: " . $proposal_data->project_title . "\n";
	$txt .= "Proposar Name: " . $proposal_data->name_title . " " . $proposal_data->contributor_name . "\n";
	$txt .= "University: " . $proposal_data->university . "\n";
	$txt .= "\n" . "\n";
	$txt .= "DWSIM Flowsheet Project By FOSSEE, IIT Bombay" . "\n";
	fwrite($readme_file, $txt);
	fclose($readme_file);
	return $txt;
}

function rrmdir_project($prop_id) {
	$proposal_id = $prop_id;
	$result = \Drupal::database()->query("SELECT * from dwsim_flowsheet_proposal WHERE id = :proposal_id", [
		':proposal_id' => $proposal_id,
	]);
	$proposal_data = $result->fetchObject();
	$root_path = dwsim_flowsheet_document_path();
	$dir = $root_path . $proposal_data->directory_name;
	if ($proposal_data->id == $prop_id) {
		if (is_dir($dir)) {
			$objects = scandir($dir);
			foreach ($objects as $object) {
				if ($object != "." && $object != "..") {
					if (filetype($dir . "/" . $object) == "dir") {
						rrmdir($dir . "/" . $object);
					}
					else {
						unlink($dir . "/" . $object);
					}
				}
			}
			reset($objects);
			rmdir($dir);
			$msg = \Drupal::messenger()->addMessage("Directory deleted successfully");
			return $msg;
		}
		$msg = \Drupal::messenger()->addMessage("Directory not present");
		return $msg;
	}
	else {
		$msg = \Drupal::messenger()->addMessage("Data not found");
		return $msg;
	}
}

function rrmdir($dir) {
	if (is_dir($dir)) {
		$objects = scandir($dir);
		foreach ($objects as $object) {
			if ($object != "." && $object != "..") {
				if (filetype($dir . "/" . $object) == "dir")
					rrmdir($dir . "/" . $object);
				else
					unlink($dir . "/" . $object);
			}
		}
		reset($objects);
		rmdir($dir);
	}
}

function _dwsim_flowsheet_list_of_user_defined_compound($proposal_id) {
	$data = "";
	$user_defined_compound_list = \Drupal::database()->query(
		"SELECT * FROM dwsim_flowsheet_user_defined_compound WHERE proposal_id = :proposal_id",
		[':proposal_id' => $proposal_id]
	);
	$headers = [
		"List of user defined compounds used in process flowsheet",
		"CAS No.",
	];
	if ($user_defined_compound_list) {
		$rows = [];
		while ($row = $user_defined_compound_list->fetchObject()) {
			$rows[] = [
				"{$row->user_defined_compound}",
				"{$row->cas_no}",
			];
		}
		$data = [
			'#type' => 'table',
			'#header' => $headers,
			'#rows' => $rows,
		];
	}
	else {
		$data .= "Not entered";
	}
	return $data;
}

function _dwsim_flowsheet_extract_mail_params(array $params, $key) {
	if (isset($params[$key]) && is_array($params[$key])) {
		return $params[$key];
	}
	return $params;
}

function _dwsim_flowsheet_append_mail_body(array &$message, $body) {
	if (is_array($body)) {
		foreach ($body as $line) {
			if ($line !== NULL && $line !== '') {
				$message['body'][] = (string) $line;
			}
		}
		return;
	}
	if ($body !== NULL && $body !== '') {
		$message['body'][] = (string) $body;
	}
}

/**
 * Implements hook_mail().
 */
function dwsim_flowsheet_mail($key, &$message, $params) {
	$mail_params = _dwsim_flowsheet_extract_mail_params((array) $params, $key);
	$langcode = !empty($message['langcode']) ? $message['langcode'] : \Drupal::languageManager()->getCurrentLanguage()->getId();
	$site_name = \Drupal::config('system.site')->get('name');

	if (!empty($mail_params['headers']) && is_array($mail_params['headers'])) {
		$message['headers'] = $mail_params['headers'];
	}

	$proposal_id = (int) ($mail_params['proposal_id'] ?? 0);
	$user_id = (int) ($mail_params['user_id'] ?? 0);
	$proposal_data = NULL;
	if ($proposal_id > 0) {
		$proposal_data = \Drupal::database()->select('dwsim_flowsheet_proposal', 'p')
			->fields('p')
			->condition('id', $proposal_id)
			->range(0, 1)
			->execute()
			->fetchObject();
	}

	if (!$user_id && !empty($proposal_data->uid)) {
		$user_id = (int) $proposal_data->uid;
	}
	$user = $user_id ? \Drupal::entityTypeManager()->getStorage('user')->load($user_id) : NULL;

	$full_name = trim(($proposal_data->name_title ?? '') . ' ' . ($proposal_data->contributor_name ?? ''));
	if ($full_name === '') {
		$full_name = $user ? $user->getDisplayName() : t('Contributor', [], ['langcode' => $langcode]);
	}

	$user_email = $user ? $user->getEmail() : ($proposal_data->contributor_email_id ?? '');
	$project_title = $proposal_data->project_title ?? t('Not available', [], ['langcode' => $langcode]);
	$university = $proposal_data->university ?? t('Not available', [], ['langcode' => $langcode]);
	$city = $proposal_data->city ?? t('Not available', [], ['langcode' => $langcode]);
	$state = $proposal_data->state ?? t('Not available', [], ['langcode' => $langcode]);
	$country = $proposal_data->country ?? t('Not available', [], ['langcode' => $langcode]);

	switch ($key) {
		case 'standard':
			$message['subject'] = (string) ($mail_params['subject'] ?? t('[@site_name] Notification', ['@site_name' => $site_name], ['langcode' => $langcode]));
			_dwsim_flowsheet_append_mail_body($message, $mail_params['body'] ?? '');
			break;

		case 'dwsim_flowsheet_proposal_received':
			$message['subject'] = t(
				'[@site_name][Flowsheeting Project] Your DWSIM Flowsheeting Project proposal has been received',
				['@site_name' => $site_name],
				['langcode' => $langcode]
			);
			$message['body'][] = t(
				"Dear @name,\n\nWe have received your DWSIM Flowsheeting Project proposal with the following details:\n\nFull Name: @full_name\nEmail: @user_email\nUniversity/Institute: @university\nCity: @city\nState: @state\nCountry: @country\nProject Title: @project_title\n\nYour proposal is under review. You will soon receive an email once it is approved or disapproved.\n\nBest Wishes,\n\n@site_name Team,\nFOSSEE, IIT Bombay",
				[
					'@name' => $full_name,
					'@full_name' => $full_name,
					'@user_email' => $user_email,
					'@university' => $university,
					'@city' => $city,
					'@state' => $state,
					'@country' => $country,
					'@project_title' => $project_title,
					'@site_name' => $site_name,
				],
				['langcode' => $langcode]
			);
			break;

		case 'circuit_simulation_proposal_received':
			if (!$proposal_data && $proposal_id > 0) {
				$proposal_data = \Drupal::database()->select('esim_circuit_simulation_proposal', 'p')
					->fields('p')
					->condition('id', $proposal_id)
					->range(0, 1)
					->execute()
					->fetchObject();
				$full_name = trim(($proposal_data->name_title ?? '') . ' ' . ($proposal_data->contributor_name ?? ''));
				$project_title = $proposal_data->project_title ?? $project_title;
				$university = $proposal_data->university ?? $university;
				$city = $proposal_data->city ?? $city;
				$state = $proposal_data->state ?? $state;
				$country = $proposal_data->country ?? $country;
			}
			$message['subject'] = t(
				'[@site_name][Circuit Simulation Project] Your eSim Circuit Simulation Project proposal has been received',
				['@site_name' => $site_name],
				['langcode' => $langcode]
			);
			$message['body'][] = t(
				"Dear @name,\n\nWe have received your eSim Circuit Simulation Project proposal with the following details:\n\nFull Name: @full_name\nEmail: @user_email\nUniversity/Institute: @university\nCity: @city\nState: @state\nCountry: @country\nProject Title: @project_title\n\nYour proposal is under review. You will soon receive an email when it has been approved/disapproved.\n\nBest Wishes,\n\n@site_name Team,\nFOSSEE, IIT Bombay",
				[
					'@name' => $full_name,
					'@full_name' => $full_name,
					'@user_email' => $user_email,
					'@university' => $university,
					'@city' => $city,
					'@state' => $state,
					'@country' => $country,
					'@project_title' => $project_title,
					'@site_name' => $site_name,
				],
				['langcode' => $langcode]
			);
			break;

		case 'dwsim_flowsheet_proposal_deleted':
			$message['subject'] = t(
				'[@site_name][Flowsheeting Project] Your DWSIM Flowsheeting proposal has been deleted',
				['@site_name' => $site_name],
				['langcode' => $langcode]
			);
			$message['body'][] = t(
				"Dear @name,\n\nYour DWSIM Flowsheeting proposal has been deleted by the review team.\n\nProject Title: @project_title\n\nYou may submit a fresh proposal if required.\n\nBest Wishes,\n\n@site_name Team,\nFOSSEE, IIT Bombay",
				['@name' => $full_name, '@project_title' => $project_title, '@site_name' => $site_name],
				['langcode' => $langcode]
			);
			break;

		case 'dwsim_flowsheet_proposal_approved':
			$message['subject'] = t(
				'[@site_name][Flowsheeting Project] Your DWSIM Flowsheeting proposal has been approved',
				['@site_name' => $site_name],
				['langcode' => $langcode]
			);
			$message['body'][] = t(
				"Dear @name,\n\nCongratulations.\n\nYour DWSIM Flowsheeting proposal has been approved.\n\nProject Title: @project_title\n\nBest Wishes,\n\n@site_name Team,\nFOSSEE, IIT Bombay",
				['@name' => $full_name, '@project_title' => $project_title, '@site_name' => $site_name],
				['langcode' => $langcode]
			);
			break;

		case 'dwsim_flowsheet_proposal_disapproved':
			$reason = trim((string) ($proposal_data->dissapproval_reason ?? ($mail_params['reason'] ?? '')));
			if ($reason === '') {
				$reason = t('Not provided', [], ['langcode' => $langcode]);
			}
			$message['subject'] = t(
				'[@site_name][Flowsheeting Project] Your DWSIM Flowsheeting proposal has been disapproved',
				['@site_name' => $site_name],
				['langcode' => $langcode]
			);
			$message['body'][] = t(
				"Dear @name,\n\nWe regret to inform you that your DWSIM Flowsheeting proposal has been disapproved.\n\nProject Title: @project_title\nReason: @reason\n\nBest Wishes,\n\n@site_name Team,\nFOSSEE, IIT Bombay",
				['@name' => $full_name, '@project_title' => $project_title, '@reason' => $reason, '@site_name' => $site_name],
				['langcode' => $langcode]
			);
			break;

		case 'dwsim_flowsheet_proposal_completed':
			$message['subject'] = t(
				'[@site_name][Flowsheeting Project] Your DWSIM Flowsheeting proposal has been marked completed',
				['@site_name' => $site_name],
				['langcode' => $langcode]
			);
			$message['body'][] = t(
				"Dear @name,\n\nCongratulations.\n\nYour DWSIM Flowsheeting proposal has been marked as completed.\n\nProject Title: @project_title\n\nBest Wishes,\n\n@site_name Team,\nFOSSEE, IIT Bombay",
				['@name' => $full_name, '@project_title' => $project_title, '@site_name' => $site_name],
				['langcode' => $langcode]
			);
			break;

		case 'abstract_uploaded':
			$message['subject'] = t(
				'[@site_name][Flowsheeting Project] We have received your abstract/files',
				['@site_name' => $site_name],
				['langcode' => $langcode]
			);
			$message['body'][] = t(
				"Dear @name,\n\nWe have received your uploaded abstract/files for the DWSIM Flowsheeting project.\n\nProject Title: @project_title\nUniversity/Institute: @university\n\nOur team will review your submission and get back to you.\n\nBest Wishes,\n\n@site_name Team,\nFOSSEE, IIT Bombay",
				['@name' => $full_name, '@project_title' => $project_title, '@university' => $university, '@site_name' => $site_name],
				['langcode' => $langcode]
			);
			break;
	}
}

function circuit_simulation_mail($key, &$message, $params) {
	dwsim_flowsheet_mail($key, $message, $params);
}
